# Copy this file to .env and replace development passwords/secrets before production.
APP_NAME=CodexGuardian
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=codexguardian
POSTGRES_USER=codexguardian
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://codexguardian:change-this-local-password@localhost:5432/codexguardian
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/github/callback
